#
# Template for the LIVE masking integration test credentials — PLACEHOLDERS ONLY.
#
# Copy this file to `tests/live/.env` (or `.env.live` at the repo root) and fill
# in the real values. BOTH local files are in `.gitignore` and are never
# committed. The password is never logged by the test, never included in error
# messages, and never enters CI. If any of the three variables is unset, the
# live test (`klaxon masking test --tenant <tenant>`, or the pytest marked
# integration/live) SKIPS cleanly instead of failing.
#
# Do NOT put credentials in the URL (https://user:pass@host) — the test warns
# and sanitises it; use the USER/PASSWORD variables with basic auth instead.
#
# The indexer must be reachable with a trusted TLS certificate (for a
# self-signed lab cluster, trust its CA on this host rather than disabling
# verification).
KLAXON_INDEXER_URL=https://indexer.example:9200
KLAXON_INDEXER_USER=admin
KLAXON_INDEXER_PASSWORD=

# Optional, NON-credential TLS knob, default true (verify, the secure default).
# Set false ONLY for a self-signed lab cluster — the test prints a warning.
#KLAXON_INDEXER_VERIFY_SSL=true
