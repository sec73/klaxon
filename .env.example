# Wazuh 5.x indexer (OpenSearch). Basic auth against the security index.
WAZUH_INDEXER_URL=https://<host>:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=

# Wazuh 5.x manager API. Uses JWT: the server posts to
# /security/user/authenticate with these credentials as basic auth, then sends
# the returned token as a bearer token. The token is cached and refreshed once
# on a 401.
WAZUH_MANAGER_URL=https://<host>:55000
WAZUH_MANAGER_USER=
WAZUH_MANAGER_PASSWORD=

# Wazuh 5.x engine, for the `tester_sessions` tool. This is the engine's own
# HTTP server: it runs inside the MANAGER container, on its own port, and is
# neither of the two URLs above. Pointed at the wrong one, /_internal/tester/*
# answers 404. No credentials are sent — the auth scheme of /_internal/* is
# undocumented, so a 401/403 is reported rather than guessed at.
# Leave unset to disable the tool.
#WAZUH_ENGINE_URL=https://<manager-host>:<engine-port>

# TLS certificate verification for all three connections above. Defaults to
# true. Setting it to false sends the credentials in this file over a
# connection nobody authenticated, so anyone able to impersonate the indexer or
# the manager collects them — use it only against a self-signed lab cluster,
# and trust the cluster CA on this host instead for anything else. The server
# logs a warning at startup whenever it is disabled.
#WAZUH_VERIFY_SSL=true

# ---------------------------------------------------------------------------
# Optional tuning. Defaults shown; all may be omitted.
# ---------------------------------------------------------------------------

# HTTP timeout in seconds for both indexer and manager requests.
#WAZUH_TIMEOUT=60

# Hard cap on an unfiltered `schema` listing. The engine schema defines 2351
# fields, so an uncapped fields=* dump is unusable.
#WAZUH_SCHEMA_FIELD_LIMIT=200

# How many exists-aggregations `schema` packs into a single search request when
# determining which mapped fields actually hold data.
#WAZUH_SCHEMA_PROBE_BATCH=100

# Ceiling for the `size` a `search` body may ask for. A Wazuh 5 event carries
# around 40 fields, so an uncapped "size": 10000 returns more document than any
# caller can hold. A larger value is lowered before the query is sent and
# reported as [SIZE CAPPED]; "size": 0 (aggregation-only queries) is untouched.
# Set to 0 to disable the cap — the server warns at startup when it is off.
#WAZUH_SEARCH_MAX_SIZE=100

# Defaults for the `logtest` tool. Both enums are enforced by the Content
# Manager and were verified against a running 5.0 instance.
#   space:       test | custom | standard   (custom decoders live in "custom")
#   trace_level: NONE | ASSET_ONLY | ALL    (ASSET_ONLY shows the decoder chain)
# A valid space name does not mean the environment is provisioned; if logtest
# reports "The '<space>' environment does not exist", try standard.
#WAZUH_LOGTEST_SPACE=custom
#WAZUH_LOGTEST_TRACE_LEVEL=ASSET_ONLY

# ---------------------------------------------------------------------------
# Transport. Leave all of this unset to run over stdio, which is what an MCP
# client spawning the process expects.
#
# READ THIS BEFORE SERVING OVER HTTP: the tools have no concept of a caller
# identity. Every request is executed with the Wazuh credentials above, so
# anyone who can reach the port can read your SIEM. Set WAZUH_MCP_AUTH_TOKEN,
# and terminate TLS in front of it.
# ---------------------------------------------------------------------------

# stdio (default) | http (streamable HTTP) | sse (legacy)
#WAZUH_MCP_TRANSPORT=stdio

# Bind address. 127.0.0.1 by default; 0.0.0.0 exposes it on every interface.
#WAZUH_MCP_HOST=127.0.0.1
#WAZUH_MCP_PORT=8000
#WAZUH_MCP_PATH=/mcp

# Shared secret required as "Authorization: Bearer <token>". Generate with
#   openssl rand -hex 32
# Unset means no authentication at all.
#WAZUH_MCP_AUTH_TOKEN=

# DNS rebinding protection: the Host/Origin values clients legitimately use.
# Comma-separated, "*" wildcard allowed for the port. When unset and bound to a
# non-loopback address, the protection is disabled and the server warns.
#WAZUH_MCP_ALLOWED_HOSTS=klaxon-mcp.example:8000
#WAZUH_MCP_ALLOWED_ORIGINS=https://klaxon-mcp.example

# Return plain JSON instead of an SSE stream, and drop per-session state.
# Useful behind a load balancer with no session affinity.
#WAZUH_MCP_JSON_RESPONSE=false
#WAZUH_MCP_STATELESS=false

# ---------------------------------------------------------------------------
# PII anonymization for non-local LLM clients (GDPR).
#
# Klaxon returns tool results to the MCP client, which feeds them to the chat
# model. When that model runs outside your network (DeepSeek cloud, Mistral
# API, ...), the results leave the building. Set the master switch to true and
# tool output is masked before it is returned: configured fields (source.ip,
# user.name, wazuh.agent.name, ...) become deterministic placeholders
# ([IP_abc123], [USER_def789], ...), and IPs/e-mails/usernames in free text
# are masked as well. Every exchange is logged with a timestamp to
# llm_prompts.log (MASKED line; no raw PII is persisted unless you opt in).
#
# Everything here can also come from an optional YAML file
# (anonymization: section in KLAXON_CONFIG, default ./config.yaml).
# Precedence: environment > YAML > default.
#
# Default is off. With the master switch on, an endpoint on loopback
# (KLAXON_LLM_BASE_URL=http://localhost:11434 for Ollama) means a local model
# and tool results pass through unchanged. An unset endpoint is treated as
# external — the GDPR-safe failure, because failing to mask is the expensive
# one.
#KLAXON_ANONYMIZE_EXTERNAL_LLM=false
#KLAXON_LLM_BASE_URL=https://api.deepseek.com/v1

# Deterministic placeholders: same value -> same placeholder.
#KLAXON_ANONYMIZATION_USE_HASH=true
#KLAXON_ANONYMIZATION_HASH_ALGORITHM=md5   # or sha256

# Comma-separated fields whose value is masked wholesale.
#KLAXON_ANONYMIZATION_MASK_FIELDS=source.ip,destination.ip,user.name,host.hostname,wazuh.agent.name,wazuh.agent.id

# Whitelist semantics: true (default) blocks a response that still contains
# residual PII after masking; false returns it masked but logs a warning.
#KLAXON_ANONYMIZATION_WHITELIST_ENABLED=true

# Audit log. RAW (unmasked) output is written only when LOG_RAW=true — and
# then the log is itself a personal-data store, so it is exported with RAW
# lines dropped for access requests (--anonymization-export).
#KLAXON_ANONYMIZATION_LOG=llm_prompts.log
#KLAXON_ANONYMIZATION_LOG_RAW=false
#KLAXON_ANONYMIZATION_LOG_MAX_LEN=20000

# Optional YAML config file for the anonymization block.
#KLAXON_CONFIG=config.yaml
